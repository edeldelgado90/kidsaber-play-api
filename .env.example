# ============================================================
# KidSaber Play API — Environment Variables Reference
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=8080
SERVER_TIMEOUT_S=30

# ── PostgreSQL (Neon or local) ────────────────────────────────
# Production: postgres://user:pass@host/db?sslmode=require
# Local:      postgres://postgres:dev@localhost:5432/kidsaber?sslmode=disable
DATABASE_URL=

# ── LLM Provider ─────────────────────────────────────────────
# Options: gemini | groq | ollama
LLM_PROVIDER=gemini

# Gemini Flash (recommended primary — free tier 1,500 req/day)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash-lite

# Groq (recommended fallback — free tier 14,400 req/day)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Ollama (local dev — unlimited)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2

# ── Authentication ────────────────────────────────────────────
# Set AUTH_ENABLED=true and a strong API_KEY in production.
#
# /questions accepts any ONE of three credentials:
#   1. Static API key — X-API-Key, or Authorization: Bearer <API_KEY>.
#      For server-to-server callers and admin tooling.
#   2. Firebase ID token — Authorization: Bearer <idToken>. The web and mobile
#      clients sign in anonymously via Firebase Auth and send the resulting
#      token. Requires FIREBASE_PROJECT_ID.
#   3. Firebase App Check token — X-Firebase-AppCheck. Requires FIREBASE_PROJECT_ID.
#
# /admin/* accepts the static API key ONLY: anyone can mint an anonymous ID
# token, so neither ID tokens nor App Check tokens open the admin surface.
#
# Generate a strong key with: openssl rand -hex 32
AUTH_ENABLED=false
API_KEY=

# FIREBASE_PROJECT_ID — enables credentials 2 and 3 above. When empty, only the
# static API key is accepted (useful for local development and CI).
# Must match the Firebase project the clients sign in to. On Cloud Run,
# Application Default Credentials are picked up automatically; locally run
# `gcloud auth application-default login` first.
FIREBASE_PROJECT_ID=

# ── Background Job ────────────────────────────────────────────
JOB_ENABLED=true
JOB_SCHEDULE=0 3 * * *
JOB_BATCH_SIZE=10
JOB_MAX_PER_COMBINATION=100
JOB_SEED_ITERATIONS=10

# ── Notifications ─────────────────────────────────────────────
# Leave empty to disable a notifier.

# Webhook (Slack / Discord / custom)
NOTIFY_WEBHOOK_URL=

# SMTP
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_FROM=
NOTIFY_SMTP_TO=

# ── Logging ───────────────────────────────────────────────────
# Options: DEBUG | INFO | WARN | ERROR (default: INFO)
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Never use a bare * in production.
#
# Each entry is either an exact origin (scheme + host + optional port) or uses a
# single leading *. in the host to match any subdomain — required for Cloudflare
# Pages, which gives every deployment its own preview hostname:
#
#   https://kidsaber-play.pages.dev     → Pages production URL
#   https://*.kidsaber-play.pages.dev   → all per-deployment preview URLs
#
# Prefer the project-scoped wildcard over https://*.pages.dev: the latter would
# let any Cloudflare Pages site in the world read question data from a browser.
#
# Production value (drop the localhost entries there):
#   https://kidsaber-play.pages.dev,https://*.kidsaber-play.pages.dev
CORS_ALLOWED_ORIGINS=http://localhost:8081,https://kidsaber-play.pages.dev,https://*.kidsaber-play.pages.dev
