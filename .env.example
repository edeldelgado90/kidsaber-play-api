# ============================================================
# KidSaber Play API — Environment Variables Reference
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=8080
SERVER_TIMEOUT_S=30

# ── PostgreSQL (Neon or local) ────────────────────────────────
# Production: postgres://user:pass@host/db?sslmode=require
# Local:      postgres://postgres:dev@localhost:5432/kidsaber?sslmode=disable
DATABASE_URL=

# ── LLM Provider ─────────────────────────────────────────────
# Options: gemini | groq | ollama
LLM_PROVIDER=gemini

# Gemini Flash (recommended primary — free tier 1,500 req/day)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash-lite

# Groq (recommended fallback — free tier 14,400 req/day)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Ollama (local dev — unlimited)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2

# ── Authentication ────────────────────────────────────────────
# Set AUTH_ENABLED=true and a strong API_KEY in production.
# The mobile app sends the key via Authorization: Bearer <key> or X-API-Key header.
AUTH_ENABLED=false
API_KEY=

# ── Background Job ────────────────────────────────────────────
JOB_ENABLED=true
JOB_SCHEDULE=0 3 * * *
JOB_BATCH_SIZE=10
JOB_MAX_PER_COMBINATION=100
JOB_SEED_ITERATIONS=10

# ── Notifications ─────────────────────────────────────────────
# Leave empty to disable a notifier.

# Webhook (Slack / Discord / custom)
NOTIFY_WEBHOOK_URL=

# SMTP
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_FROM=
NOTIFY_SMTP_TO=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Never use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
