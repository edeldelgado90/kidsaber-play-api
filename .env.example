# ============================================================
# KidSaber Play API — Environment Variables Reference
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=8080
SERVER_TIMEOUT_S=30

# ── PostgreSQL (Neon or local) ────────────────────────────────
# Production: postgres://user:pass@host/db?sslmode=require
# Local:      postgres://postgres:dev@localhost:5432/kidsaber?sslmode=disable
DATABASE_URL=

# ── LLM Provider ─────────────────────────────────────────────
# Options: gemini | groq | ollama
LLM_PROVIDER=gemini

# Gemini Flash (recommended primary — free tier 1,500 req/day)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash-lite

# Groq (recommended fallback — free tier 14,400 req/day)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Ollama (local dev — unlimited)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2

# ── Authentication ────────────────────────────────────────────
# Set AUTH_ENABLED=true and a strong API_KEY in production.
#
# How the mobile app authenticates:
#   1. App calls POST /auth/token with a stable device ID.
#   2. API returns a short-lived signed token (TOKEN_TTL_S seconds).
#   3. App sends Authorization: Bearer <token> on all subsequent requests.
#   Server-side tools / admin routes use the static API_KEY directly.
#
AUTH_ENABLED=false
API_KEY=

# TOKEN_SECRET — HMAC-SHA256 signing key for device tokens issued by POST /auth/token.
# If left empty, the secret is automatically derived from API_KEY (no extra config
# needed for simple deployments). Set TOKEN_SECRET explicitly to allow rotating
# device tokens independently of the API key.
# Generate a strong value with: openssl rand -hex 32
TOKEN_SECRET=

# TOKEN_TTL_S — device token lifetime in seconds (default 86400 = 24 hours).
TOKEN_TTL_S=86400

# ── Background Job ────────────────────────────────────────────
JOB_ENABLED=true
JOB_SCHEDULE=0 3 * * *
JOB_BATCH_SIZE=10
JOB_MAX_PER_COMBINATION=100
JOB_SEED_ITERATIONS=10

# ── Notifications ─────────────────────────────────────────────
# Leave empty to disable a notifier.

# Webhook (Slack / Discord / custom)
NOTIFY_WEBHOOK_URL=

# SMTP
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_FROM=
NOTIFY_SMTP_TO=

# ── Logging ───────────────────────────────────────────────────
# Options: DEBUG | INFO | WARN | ERROR (default: INFO)
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Never use a bare * in production.
#
# Each entry is either an exact origin (scheme + host + optional port) or uses a
# single leading *. in the host to match any subdomain — required for Cloudflare
# Pages, which gives every deployment its own preview hostname:
#
#   https://*.kidsaber-play.pages.dev   → all previews of that project
#   https://kidsaber-play.pages.dev     → the project's production URL
#   https://play.kidsaber.app           → custom domain
#
# Prefer the project-scoped wildcard over https://*.pages.dev: the latter would
# let any Cloudflare Pages site in the world read question data from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
